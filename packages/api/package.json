{
  "name": "@tiktok-gram/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "verify:api": "tsx scripts/verify-step4.ts",
    "verify:ui": "tsx scripts/verify-step5-8.ts",
    "verify:step9": "tsx scripts/verify-step9.ts",
    "verify:step11-feed-cache": "tsx scripts/verify-step11-feed-cache.ts"
  },
  "dependencies": {
    "@tiktok-gram/db": "workspace:*",
    "@tiktok-gram/validators": "workspace:*",
    "@trpc/server": "catalog:",
    "drizzle-orm": "^0.44.7",
    "superjson": "2.2.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tiktok-gram/eslint-config": "workspace:*",
    "@tiktok-gram/prettier-config": "workspace:*",
    "@tiktok-gram/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.21.1",
    "typescript": "catalog:"
  },
  "prettier": "@tiktok-gram/prettier-config"
}
