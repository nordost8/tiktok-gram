# Local development. See docs/setup/deploy.md for the Docker/production setup
# (deploy/pi/.env.example), which uses different hostnames (postgres, redis).

# --- Postgres (run locally, e.g. `docker run -p 5432:5432 postgres:17-alpine`) --
POSTGRES_URL="postgresql://tiktok_gram_app:PASSWORD@localhost:5432/tiktok_gram"

# --- Redis: media cache queue + music-enrichment job queue -------------------
REDIS_URL="redis://localhost:6379"

# --- Cloudflare R2 — see docs/setup/cloudflare-r2.md -------------------------
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="<R2_ACCESS_KEY>"
S3_SECRET_ACCESS_KEY="<R2_SECRET_KEY>"
S3_BUCKET="tiktok-gram-media"
S3_REGION="auto"

# --- Dev server ---------------------------------------------------------------
PORT=3000

# --- Collector / feed ----------------------------------------------------------
COLLECTOR_LIMIT=15
COLLECTOR_VIDEO_ONLY=0
FEED_ALLOW_PHOTOS=1

# Music enrichment (see docs/music-enrichment.md) — the recommendation logic is
# a documented stub by default: every enriched photo post gets the same
# placeholder track until you implement a real one in
# services/music-enrichment/app/pipeline/.
MUSIC_ENRICHMENT_ENABLED=0

PHOTO_POST_LIMIT=5000
MEDIA_CACHE_PROTECT_PER_CHANNEL=5

# --- Mini App bot token — native shareMessage (savePreparedInlineMessage) ----
# TELEGRAM_BOT_TOKEN=

# --- Telegram userbot (collector) — see docs/setup/telegram.md --------------
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_PHONE=+1...
# TELEGRAM_LOGIN_CODE=
# TELEGRAM_2FA_PASSWORD=

# --- Public site URL (webhook registration + Mini App deep links) ----------
# SITE_URL=https://your-domain.example.com

# --- Caddy / reverse proxy (production only; see deploy/pi/.env.example) ---
# TIKTOK_GRAM_SITE_ADDRESS=your-domain.example.com
# TIKTOK_GRAM_HTTP_PORT=3090

# --- Media cache worker (optional — overrides defaults) ---------------------
# MEDIA_CACHE_MAX_BYTES=262144000
# MEDIA_CACHE_JOB_TIMEOUT=900
# MEDIA_CACHE_BUDGET_BYTES=9800000000
# MEDIA_CACHE_PROTECT_POSTS=200

# --- Optional: auto-translate non-English post captions ----------------------
# CAPTION_TRANSLATE_ENABLED=1
# LAPATHONIIA_API_KEY=
# LAPATHONIIA_MODEL=
# LAPATHONIIA_BASE_URL=
# LAPATHONIIA_TRANSLATE_MODEL=

# --- UI language: "en" (default) or "uk" -------------------------------------
LOCALE=en

# Optional support/community link shown in Settings and Profile. Hidden when unset.
# SUPPORT_URL=https://t.me/your_support_chat

# Unset → shared messages have no "open in <app>" button.
TELEGRAM_MINIAPP_DEEPLINK=
