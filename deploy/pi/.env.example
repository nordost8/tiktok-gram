# Copy to deploy/pi/.env before `docker compose up -d`.
# See docs/setup/deploy.md for the full walkthrough.

# --- Postgres (own container, started by docker-compose.yml) ---------------
POSTGRES_USER=tiktok_gram_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tiktok_gram
POSTGRES_URL=postgresql://tiktok_gram_app:change-me@postgres:5432/tiktok_gram

# --- Redis (own container) --------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Telegram userbot (collector) — see docs/setup/telegram.md -------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Only needed for the one-time login (pnpm telegram:channels); safe to leave
# unset afterwards, since the session is stored in Postgres.
TELEGRAM_PHONE=
TELEGRAM_LOGIN_CODE=
TELEGRAM_2FA_PASSWORD=

# Mini App bot — see docs/setup/telegram.md ("Bot API bot" section).
TELEGRAM_BOT_TOKEN=

COLLECTOR_LIMIT=15
# Collector ingestion: 0 = also ingest photo-only albums
COLLECTOR_VIDEO_ONLY=0
# Feed (web): 1 = show photo posts in the feed
FEED_ALLOW_PHOTOS=1

# --- Music enrichment (see docs/music-enrichment.md) ------------------------
# The recommendation logic is a documented stub by default: every enriched
# photo post gets the same placeholder track until you implement a real one
# in services/music-enrichment/app/pipeline/.
MUSIC_ENRICHMENT_ENABLED=0

# Max single file to cache (default 250MB); oversize → skipped
# MEDIA_CACHE_MAX_BYTES=262144000
# Photo-only posts: bytes in Postgres (PHOTO_POST_LIMIT, default 5000). Video stays in R2.
PHOTO_POST_LIMIT=5000
# MEDIA_CACHE_BUDGET_BYTES=10737418240
# Do not evict cache for N newest ready posts (default 40)
# MEDIA_CACHE_PROTECT_POSTS=40

# --- Caddy / reverse proxy ---------------------------------------------------
TIKTOK_GRAM_HTTP_PORT=3090
TIKTOK_GRAM_SITE_ADDRESS=:80
# For HTTPS with a real domain instead of a tunnel:
# TIKTOK_GRAM_SITE_ADDRESS=tiktok-gram.example.com
# ACME_EMAIL=you@example.com
ACME_EMAIL=

# Public URL of the deployed app — used to register the Telegram bot webhook
# and to build Mini App deep links. Leave unset in local dev.
SITE_URL=

# --- Cloudflare R2 — see docs/setup/cloudflare-r2.md ------------------------
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=<r2_access_key_id>
S3_SECRET_ACCESS_KEY=<r2_secret_access_key>
S3_BUCKET=<bucket_name>
S3_REGION=auto

# --- UI language: "en" (default) or "uk" ------------------------------------
LOCALE=en

# Optional support/community link shown in Settings and Profile. Hidden when unset.
# SUPPORT_URL=https://t.me/your_support_chat

# --- Optional: auto-translate non-English post captions (fastText + LLM) ----
# Any OpenAI-compatible API (OpenAI, DeepSeek, local Ollama/vLLM, OpenRouter…).
# Lapa on the diagram is just an example. See README § Caption translation.
# CAPTION_TRANSLATE_ENABLED=1
# CAPTION_TRANSLATE_API_KEY=sk-...
# CAPTION_TRANSLATE_BASE_URL=https://api.openai.com/v1
# CAPTION_TRANSLATE_MODEL=gpt-4o-mini
# Legacy aliases: LAPATHONIIA_API_KEY, LAPATHONIIA_BASE_URL, LAPATHONIIA_TRANSLATE_MODEL
